{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getvisionid.pythonanywhere.com/schemas/frame-catalog-v1.json",
  "title": "VisionID canonical multi-source frame catalog record",
  "type": "object",
  "required": [
    "schemaVersion", "source", "sourceProductId", "sourceProductUrl",
    "sourceScopedSku", "brand", "name", "retrievedAt",
    "dataLicense", "imageLicense", "allowedUses", "attribution", "termsUrl",
    "shape", "lensWidthMm", "lensHeightMm", "bridgeWidthMm", "frameWidthMm", "imageUrl"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sourceProductId": { "type": "string", "minLength": 1 },
    "sourceProductUrl": { "type": "string", "format": "uri" },
    "sourceScopedSku": { "type": "string", "minLength": 1 },
    "brand": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": ["string", "null"], "format": "date-time" },
    "dataLicense": { "type": ["string", "null"] },
    "imageLicense": { "type": ["string", "null"] },
    "allowedUses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "attribution": { "type": ["string", "null"] },
    "termsUrl": { "type": ["string", "null"], "format": "uri" },
    "shape": { "type": "string", "minLength": 1 },
    "lensWidthMm": { "type": "number", "exclusiveMinimum": 0 },
    "lensHeightMm": { "type": "number", "exclusiveMinimum": 0 },
    "bridgeWidthMm": { "type": "number", "exclusiveMinimum": 0 },
    "frameWidthMm": { "type": "number", "exclusiveMinimum": 0 },
    "imageUrl": { "type": "string", "format": "uri" },
    "model": { "type": ["string", "null"] },
    "material": { "type": ["string", "null"] },
    "rimType": { "type": ["string", "null"] },
    "templeLengthMm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "color": { "type": ["string", "null"] },
    "colorFamily": { "type": ["string", "null"] },
    "styleTags": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
    "price": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"] },
    "availability": { "type": ["boolean", "null"] },
    "stock": { "type": ["integer", "null"], "minimum": 0 },
    "lastAvailabilityCheck": { "type": ["string", "null"], "format": "date-time" }
  }
}
